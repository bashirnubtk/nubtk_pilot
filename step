# 🧱 Step 4 – index.js Replace করুন

`functions/index.js` ওপেন করে সব delete করে নিচের কোড বসান:

```js
const functions = require("firebase-functions");
const admin = require("firebase-admin");

admin.initializeApp();

exports.generateDigitalId = functions.firestore
  .document("students/{studentId}")
  .onUpdate(async (change, context) => {
    const before = change.before.data();
    const after = change.after.data();

    // Only run when approved becomes true
    if (!before.approved && after.approved) {
      const db = admin.firestore();
      const counterRef = db.collection("counters").doc("student_id");

      return db.runTransaction(async (transaction) => {
        const counterDoc = await transaction.get(counterRef);
        let current = counterDoc.data().current || 0;

        const newSerial = current + 1;

        transaction.update(counterRef, { current: newSerial });

        const year = new Date().getFullYear();
        const padded = String(newSerial).padStart(4, "0");
        const newId = `NUBTK-${year}-${padded}`;

        const studentRef = db.collection("students").doc(context.params.studentId);

        transaction.update(studentRef, {
          digitalId: newId,
        });

        console.log("Digital ID generated:", newId);
      });
    }

    return null;
  });
```

